# Required for live data. Hackathon keys only work against the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional. Enables the LLM-only baseline, the client-facing narrative and
# mapping of words outside the built-in lexicon. Everything else runs without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Set to "fixture" to run on clearly-labelled SYNTHETIC data (tests, UI work).
# Never use fixture mode for a public demo.
QLOO_MODE=

# Optional persistence for briefs + outcome tracking (Upstash Redis / Vercel KV REST).
# Without these, briefs are stored in .data/ on local disk (ephemeral on serverless).
KV_REST_API_URL=
KV_REST_API_TOKEN=
