# Copy to .env.local. Nothing here is required to try Tastespec: `npm run demo`
# runs on clearly-labelled synthetic data with no keys at all.

# Live Qloo evidence. Hackathon keys only work against the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# "fixture" = synthetic data (labelled everywhere). Leave empty for live data.
QLOO_MODE=

# Optional Claude features: reading a pasted message, the LLM-only counter-test,
# mapping unfamiliar words and place tags, the client note and hand-over prose.
# Every model output is validated or grounded; spec values never come from it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Storage. Default: an embedded SQLite file at ./.data/tastespec.db (any OS, Node 22.13+).
# For serverless or multi-instance hosting use libSQL / Turso over HTTP:
#   DATABASE_URL=libsql://your-db.turso.io   DATABASE_AUTH_TOKEN=...
# or point at another SQLite file: DATABASE_URL=file:/var/lib/tastespec/tastespec.db
DATABASE_URL=
DATABASE_AUTH_TOKEN=
TASTESPEC_DB_PATH=
# Briefs untouched for this many days are deleted (default 180).
TASTESPEC_RETENTION_DAYS=180

# Per-IP limit on new briefs per 10 minutes (default 12).
TASTESPEC_RUNS_PER_10_MIN=12
