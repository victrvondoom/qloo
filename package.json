{
  "name": "tastespec",
  "version": "1.0.0",
  "private": true,
  "description": "Clients say 'warm and modern'. Tastespec finds out what they mean, using Qloo's taste graph, and turns it into a spec a pro can build, with every line traced to evidence.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run benchmark",
    "probe": "tsx --tsconfig tsconfig.json scripts/probe-qloo.ts",
    "benchmark": "tsx --tsconfig tsconfig.json benchmarks/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
